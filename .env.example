# Only configured, allowlisted free models are eligible. Keys remain local.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
HF_TOKEN=
ZAI_API_KEY=
COHERE_API_KEY=
# Disabled by Free Guard if a payment method is required.
CEREBRAS_API_KEY=
LOCAL_ONLY=false

# Provider requests: seconds; finite, bounded values. 429 honors Retry-After.
BARQ_CONNECT_TIMEOUT=10
BARQ_PROVIDER_TIMEOUT=45
BARQ_LOCAL_TIMEOUT=200
BARQ_FIRST_TOKEN_TIMEOUT=21
BARQ_PROVIDER_RETRIES=2
BARQ_RETRY_BASE_SECONDS=0.4
BARQ_RETRY_MAX_SECONDS=4
# Maximum approved tool rounds in one task; no unbounded execution.
BARQ_AGENT_MAX_ROUNDS=40
BARQ_LOG_LEVEL=INFO

# Blank context uses the adaptive resource/profile limit, capped by each model.
# An explicit number is an upper bound, never an instruction to exhaust memory.
OLLAMA_NUM_CTX=
OLLAMA_KEEP_ALIVE=10m
# Offline STT uses an existing downloaded folder; no automatic downloads.
# BARQ_LOCAL_STT_MODEL_PATH=C:\AI\whisper-small
# REA_COMMAND=C:\Tools\rea.exe

# BARQ model coordination: bounded planning timeouts in seconds.
# Auto tests downloaded Ollama coding models first; cloud models remain free-only fallbacks.
BARQ_PLAN_LOCAL_FIRST_SECONDS=28
BARQ_PLAN_LOCAL_CANDIDATES=2
BARQ_PLAN_BUDGET_SECONDS=32
BARQ_PLAN_MODEL_SECONDS=14
BARQ_PLAN_CLOUD_CANDIDATES=3

# Optional official Microsoft Outlook OAuth device flow (Mail.ReadBasic only).
# Set your public-client app id. No Microsoft passwords or tokens go in this file.
BARQ_MS_CLIENT_ID=

# Optional hosted watching and music relay (see docs/watch-relay.md).
# Configure both on host devices. A guest browser uses the invite directly.
BARQ_WATCH_RELAY_URL=
BARQ_WATCH_RELAY_TOKEN=
